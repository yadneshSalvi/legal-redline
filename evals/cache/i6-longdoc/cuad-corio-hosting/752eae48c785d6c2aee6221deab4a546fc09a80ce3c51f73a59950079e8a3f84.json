            },
            {
              "kind": "replace",
              "paragraphId": "p0116",
              "oldText": "intellectual property rights in the Developments. To the extent",
              "newText": "To the extent"
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0116",
              "text": "To the extent any Commerce One materials or technology are embedded in the Developments, Commerce One hereby grants Corio a perpetual, irrevocable, royalty-free license to use such materials or technology as part of the Developments."
            },
            {
              "kind": "replace",
              "paragraphId": "p0116",
              "oldText": "which may be developed jointly by the parties or solely by Corio shall be negotiated by the parties prior to the start of any such development work.",
              "newText": "which may be developed jointly by the parties or solely by Corio shall be negotiated by the parties prior to the start of any such development work, provided that the parties shall not jointly own any intellectual property."
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0119",
              "numbering": "13.7",
              "text": "Data. As between the parties, Corio retains all right, title and interest in and to all data belonging to, supplied by, or processed for Corio or its Customers, and Commerce One shall not use such data other than to process it solely to provide the services under this Agreement."
            }
          ]
        },
