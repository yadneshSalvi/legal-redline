        "input": {
          "level": "preferred",
          "summary": "Replace mandatory JAMS arbitration with exclusive jurisdiction of the state and federal courts in New York County and conform the remaining dispute-resolution mechanics.",
          "comment": "[Playbook] New York law is agreed, but our position requires the merits to be heard by courts rather than by arbitration in an undisclosed seat, so we have routed Disputes to the exclusive jurisdiction of the state and federal courts in New York County and removed the now-inapplicable arbitral machinery. We have kept the interim injunctive-relief carve-out and the stay of termination during a pending proceeding, conformed only to the new forum.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0629",
