            {
              "kind": "insert_after",
              "paragraphId": "p0024",
              "text": "The Company may terminate this Agreement at any time for convenience, with or without cause, upon ninety (90) days' prior written notice to HDI. Any termination by HDI under this Section 4.1 shall be effective only at the end of the then-current term, and any Termination Date specified in HDI's notice shall be the last day of that term."
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0029",
              "numbering": "(d)",
              "text": "In no event shall the Termination Payment exceed the amounts payable by the Company to HDI under Section 3 for the three (3) months preceding the Termination Date."
