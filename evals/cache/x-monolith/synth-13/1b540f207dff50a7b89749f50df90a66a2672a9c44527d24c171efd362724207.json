        "input": {
          "ruleId": "LOL-CAP",
          "level": "preferred",
          "summary": "Make the cap the greater of 12 months' Fees or USD 1M and preserve the Excluded Claims carve-outs.",
          "comment": "[Playbook] A one-month cap applied \"without exception\" is far below our floor of 12 months' fees and would swallow the Excluded Claims in Section 21.3, so we have reset the basis to the greater of 12 months' Fees or USD 1,000,000 and restored the carve-out. Indemnification, confidentiality, data-protection and security breaches sit outside the cap.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0082",
              "oldText": "Each Party's aggregate liability shall not exceed Fees actually paid in the one month preceding the event, without exception.",
              "newText": "Except for Excluded Claims, each Party's aggregate liability shall not exceed the greater of (a) the Fees paid or payable by Customer under this Agreement in the twelve months immediately preceding the event giving rise to the claim and (b) USD 1,000,000."
            }
          ]
        },
        "caller": {
          "type": "direct"
        }
      },
      {
        "type": "tool_use",
        "id": "toolu_01DMhMdyBLjS3EMSwkqhMPKm",
        "name": "propose_redline",
        "input": {
          "ruleId": "INDEMN",
          "level": "preferred",
          "summary": "Add a Vendor IP/misconduct indemnity and narrow the Customer indemnity.",
          "comment": "[Playbook] Section 20 currently runs one way only, so we have added the Vendor indemnity for third-party IP claims, breach of law, data breach and wilful misconduct, and narrowed our indemnity to Customer-provided content and our own breach of law.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0080",
              "oldText": "Customer shall defend, indemnify, and hold harmless Vendor from every claim relating in any way to Customer's use of the Services.",
              "newText": "Customer shall defend, indemnify, and hold harmless Vendor from third-party claims to the extent arising out of Customer-provided content or Customer's breach of Applicable Law."
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0080",
              "numbering": "20.2",
              "text": "Vendor shall defend, indemnify, and hold harmless Customer and its Affiliates from and against any third-party claim, and all resulting damages, costs, and expenses (including reasonable attorneys' fees), to the extent arising out of (a) an allegation that the Services or Deliverables infringe or misappropriate any intellectual property right; (b) Vendor's breach of Applicable Law; (c) any unauthorized access to or disclosure of Customer Data caused by Vendor; or (d) Vendor's gross negligence or wilful misconduct. The indemnified Party shall give prompt notice and reasonable cooperation, and the indemnifying Party controls the defence and settlement, provided no settlement imposes an obligation on the indemnified Party without its consent."
            }
          ]
        },
        "caller": {
          "type": "direct"
        }
      },
