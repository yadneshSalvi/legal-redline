        "input": {
          "level": "preferred",
          "summary": "Corio owns Developments outright; add embedded-IP licence back, Corio data ownership, and no joint ownership",
          "comment": "[Playbook] We must own the work product we create, so we have deleted the carve-out that hands ownership of Corio-created Developments to Commerce One whenever it supports them, and added a perpetual, irrevocable, royalty-free licence to any Commerce One IP embedded in the Developments. We have also confirmed Corio's ownership of its data (with Commerce One's use limited to providing the Software and services) and that no IP is jointly owned.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0115",
              "oldText": "shall be owned by Corio, unless such Developments are supported on an ongoing basis by Commerce One in which case Commerce One will retain all ownership rights, including",
              "newText": "shall be owned by Corio, including"
            },
            {
              "kind": "replace",
              "paragraphId": "p0116",
              "oldText": "Ownership of intellectual property rights to any enhancements, modifications or derivative works to the Software itself which may be developed jointly by the parties or solely by Corio shall be negotiated by the parties prior to the start of any such development work.",
              "newText": "Ownership of intellectual property rights to any enhancements, modifications or derivative works to the Software itself which may be developed jointly by the parties or solely by Corio shall be negotiated by the parties prior to the start of any such development work, provided that no intellectual property shall be jointly owned by the parties."
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0116",
              "numbering": "13.5.1",
              "text": "Commerce One grants Corio a perpetual, irrevocable, royalty-free license to use any Commerce One intellectual property embedded in the Developments. Corio retains all right, title and interest in all data belonging to, supplied by or processed for Corio or its Customers, and any Commerce One license in such data is limited to processing that data solely to provide the Software, the MarketSite.net Service and Maintenance and Support under this Agreement."
            }
          ]
        },
