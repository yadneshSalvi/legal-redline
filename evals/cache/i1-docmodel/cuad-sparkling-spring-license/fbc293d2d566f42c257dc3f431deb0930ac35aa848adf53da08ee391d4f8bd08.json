        "name": "propose_redline",
        "input": {
          "ruleId": "ASSIGN",
          "level": "preferred",
          "summary": "Add affiliate/successor assignment carve-out for Sparkling and a reasonableness standard",
          "comment": "[Playbook] A blanket assignment bar with no M&A carve-out is not something we can accept. We have added the affiliate and successor carve-out for Sparkling and made consent for other assignments subject to a reasonableness standard.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0142",
              "oldText": "(d) Neither party may assign this Agreement or any rights and obligations under this Agreement to any third party without the written consent of the other party.",
              "newText": "(d) Neither party may assign this Agreement or any rights and obligations under this Agreement to any third party without the written consent of the other party, which consent shall not be unreasonably withheld or delayed; provided that Sparkling may assign this Agreement, without consent, to an affiliate or to a successor in connection with a merger, acquisition, reorganization or sale of all or substantially all of its assets, and no such transaction or change of control of Sparkling shall give Garman any right to terminate or re-price this Agreement."
            }
          ]
