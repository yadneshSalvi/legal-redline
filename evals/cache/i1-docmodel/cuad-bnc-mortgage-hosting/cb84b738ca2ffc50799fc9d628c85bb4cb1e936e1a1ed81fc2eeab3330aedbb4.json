        "input": {
          "ruleId": "IP",
          "level": "preferred",
          "summary": "Narrow the Credit Data licence to service provision and confirm Client retains all rights in its content and data.",
          "comment": "[Playbook] Section 8(d) lets TrueLink distribute, license, resell and exploit our borrowers' Credit Data; we can only grant a licence to use that data to provide the services, and we retain all rights in Client Content, Credit Data and Client's Intellectual Property.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0054",
              "oldText": "Client hereby grants to TrueLink the nonexclusive worldwide right and license to use, distribute, disseminate, license, resell, exploit, upload, display, copy and store Credit Data subject to the limitations set forth in and in accordance with the Non-Competition Agreement.",
              "newText": "Client hereby grants to TrueLink a nonexclusive, worldwide, royalty-free right and license to use, upload, display, copy, transmit and store Credit Data solely as necessary to provide the Hosting Services and Support Services to Client, subject to the limitations set forth in and in accordance with the Non-Competition Agreement. TrueLink shall not distribute, disseminate, license, resell or otherwise exploit Credit Data for any other purpose, and Client retains all right, title and interest in and to Client Content, Credit Data and Client's Intellectual Property."
            }
