        "input": {
          "level": "preferred",
          "precedentId": "seed-govlaw",
          "summary": "Add New York governing law and exclusive New York County court jurisdiction in place of the no-governing-law provision, and remove the sole-and-exclusive-remedy bar to court proceedings.",
          "comment": "[Playbook] We replaced Subparagraph 27.2, which deliberately left no governing law, with our accepted position that New York law governs and that the state and federal courts in New York County have exclusive jurisdiction, and we conformed 27.1 so the Management Committee procedure no longer bars access to those courts.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0263",
              "oldText": "27.2 If any difference shall arise between or among the Parties or any of them in respect of the interpretation or effect of this Agreement or any part or provision thereof or their rights and obligations thereunder, and by reasons thereof there shall arise the need to decide the question by what municipal or national law this Agreement or any part or provision thereof is governed, the following facts shall be excluded from consideration, namely that this Agreement was made in a particular country and that it may appear by reason of its form, style, language or otherwise to have been drawn preponderantly with reference to a particular system of municipal or national law; the intention of the Parties being that such facts shall be regarded by the Parties and in all courts and tribunals wherever situated as irrelevant to the question aforesaid and to the decision thereof.",
              "newText": "27.2 This Agreement is governed by New York law, with exclusive jurisdiction in the state and federal courts in New York County."
            },
            {
              "kind": "replace",
              "paragraphId": "p0262",
              "oldText": "This procedure shall be the sole and exclusive remedy for any dispute which may arise under this Agreement between or among the Parties.",
              "newText": "This procedure shall not limit any Party's right to bring the dispute before the courts specified in Subparagraph 27.2."
            }
          ]
        },
