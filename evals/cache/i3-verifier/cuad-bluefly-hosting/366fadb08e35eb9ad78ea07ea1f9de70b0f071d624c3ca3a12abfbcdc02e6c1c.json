        "input": {
          "level": "preferred",
          "summary": "Default Materials to Customer-owned Type I, broaden the Type II licence-back to include modification and sublicensing, and confirm Customer ownership of Content and Customer Components.",
          "comment": "[Playbook] Our playbook requires that we own the deliverables created for us, so we have made Type I (Customer-owned) the default where Materials are not otherwise specified, and confirmed that we retain all rights in our Content and Customer Components. Where IBM retains ownership of pre-existing Type II Materials, we need a perpetual licence that includes the right to modify and sublicense for our business purposes; retaining IBM ownership of its platform and generic tools is acceptable.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0082",
              "oldText": "If not specified, Materials will be considered Type II Materials.",
              "newText": "If not specified, Materials will be considered Type I Materials."
            },
            {
              "kind": "replace",
              "paragraphId": "p0085",
              "oldText": "IBM grants Customer an irrevocable, nonexclusive, worldwide, paid-up license to use, execute, reproduce, display, perform, and distribute, within Customer's Enterprise only, copies of Type II Materials.",
              "newText": "IBM grants Customer a perpetual, irrevocable, nonexclusive, worldwide, paid-up license to use, execute, reproduce, display, perform, modify, prepare derivative works based on, and distribute copies of Type II Materials for Customer's business purposes, and to sublicense these rights to its Affiliates, Subcontractors and Services Recipients."
            },
            {
              "kind": "insert_after",
              "paragraphId": "p0086",
              "numbering": "e.",
              "text": "e. Customer retains all right, title, and interest (including all intellectual property rights) in and to the Content and the Customer Components. Nothing in this Agreement assigns or transfers to IBM any ownership of the Content or the Customer Components, and IBM obtains no rights in them other than the limited rights expressly granted in this Agreement for the purpose of performing the Services."
            }
          ]
        },
