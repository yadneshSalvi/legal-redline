        "input": {
          "level": "preferred",
          "summary": "Add an Issuer right to terminate the Servicer for convenience on 30 days' notice, without penalty and with refund of prepaid Servicing Fees.",
          "comment": "[Playbook] Article VII lets us remove Cellco only on a Servicer Termination Event (and then only through the Indenture Trustee), so we have no ability to exit this multi-year servicing engagement without cause. We have added a 30 days' notice termination-for-convenience right in our favour, with no termination fee and a refund of Servicing Fees prepaid for the post-termination period, dovetailed into the existing Successor Servicer machinery in Sections 7.3 through 7.5. If 30 days is too tight operationally, we can live with 60-90 days' notice.",
          "ops": [
            {
              "kind": "insert_after",
              "paragraphId": "p0316",
              "numbering": "Section 7.1A",
              "text": "Section 7.1A Termination for Convenience by the Issuer. In addition to any other right of removal or termination under this Agreement, the Issuer, at the direction of the Depositor, may terminate the rights and obligations of the Servicer under this Agreement for convenience, in whole or in part, at any time upon thirty (30) days' prior written notice to the Servicer, the Owner Trustee and the Indenture Trustee, without payment by the Issuer or the Depositor of any termination fee, penalty, make-whole or other compensation, and the Servicer will refund any Servicing Fee paid in respect of the period after the effective date of such termination. Sections 7.3, 7.4 and 7.5 will apply to a termination under this Section 7.1A as if the Servicer had been terminated under Section 7.2(c)."
            }
          ]
        },
        "caller": {
          "type": "direct"
        }
      }
