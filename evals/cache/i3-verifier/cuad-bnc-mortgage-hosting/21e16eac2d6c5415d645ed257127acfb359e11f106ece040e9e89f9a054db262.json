        "input": {
          "level": "preferred",
          "summary": "Extend licence to Client's affiliates and contractors, allow revocation only for uncured material breach, and permit transfer to a successor.",
          "comment": "[Playbook] We extended the licence to our affiliates and to contractors acting on our behalf, since our origination processing is carried out across group entities and outsourced providers, and aligned Section 8(c) accordingly. We also limited the automatic termination of the licence to uncured material breach and allowed transfer to a successor in a corporate transaction; if helpful, we can accept affiliate coverage on written notice as a fallback.",
          "ops": [
            {
              "kind": "replace",
              "paragraphId": "p0022",
              "oldText": "TrueLink hereby grants to Client a non-exclusive license to use the Interface",
              "newText": "TrueLink hereby grants to Client, its affiliates and its contractors acting on Client's behalf a non-exclusive license to use the Interface"
            },
            {
              "kind": "replace",
              "paragraphId": "p0053",
              "oldText": "to restrict access to the Interface to its officers, employees, and agents as may be approved by Client",
              "newText": "to restrict access to the Interface to the officers, employees, contractors and agents of Client and its affiliates as may be approved by Client"
            },
            {
              "kind": "replace",
              "paragraphId": "p0078",
              "oldText": "or (b) any violations or breach by Client of Sections 8a - 8c.",
              "newText": "or (b) any material violation or breach by Client of Sections 8a - 8c which has not been cured within thirty (30) days after written notice thereof."
            },
            {
              "kind": "replace",
              "paragraphId": "p0080",
              "oldText": "except no such approval shall be required for an assignment to a financially responsible affiliate.",
              "newText": "except no such approval shall be required for an assignment to a financially responsible affiliate or to a successor in connection with a merger, acquisition, reorganization or sale of all or substantially all of the assigning party's assets."
            }
          ]
        },
