# Copy to .env — never commit real keys.
ANTHROPIC_API_KEY=            # required for live runs (Claude Opus 5 drafter/verifier)
OPENAI_API_KEY=               # required for --live eval judging (GPT-5.6 independent judge)
# Optional
BLOB_READ_WRITE_TOKEN=        # Vercel Blob store for deployed runs (local dev uses ./data/runs)
REDLINER_STORE=fs             # fs | blob | memory
REDLINER_LLM_MODE=replay      # replay | live | record — replay needs no keys (samples + eval use evals/cache); set live to review your own documents
